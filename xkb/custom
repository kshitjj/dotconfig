default partial modifier_keys
xkb_symbols "custom" {
    key <CAPS> { [ ISO_Level3_Shift ] };
    modifier_map Mod5 { ISO_Level3_Shift };

    key <AC07> { [ h, H, Left,          dollar ] };
    key <AD10> { [ l, L, Right,         asciitilde ] };
    key <AB03> { [ j, J, Down,          NoSymbol ] };
    key <AB04> { [ k, K, Up,            NoSymbol ] };
    key <AC03> { [ e, E, Escape,        NoSymbol ] };
    key <AD07> { [ g, G, BackSpace,     NoSymbol ] };
    key <AB05> { [ x, X, Delete,        NoSymbol ] };
};
